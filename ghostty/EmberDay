# EmberDay for Ghostty, part of cosmic-emberday-theme (MIT).
# Colours follow the COSMIC Terminal scheme (cosmic-term/).
#
# Install: ./ghostty/install.sh puts this in ~/.config/ghostty/themes/, then in
# ~/.config/ghostty/config:
#   theme = EmberDay
# or, with the Ember half installed too, following COSMIC's Dark / Light toggle:
#   theme = dark:Ember,light:EmberDay

background = #DDD9D1
foreground = #2B2E36

cursor-color = #A4441A
cursor-text = #DDD9D1

selection-background = #BBB9B2
selection-foreground = #2B2E36

split-divider-color = #BBB9B2
unfocused-split-fill = #DDD9D1

