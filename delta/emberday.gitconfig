# EmberDay for delta (the git diff pager), part of cosmic-emberday-theme (MIT).
# Removed lines in the error colour, added lines in the success colour, both
# on the editor's container; changed words on a solid error / success block
# with the editor background as text (the same as DiffAdd / DiffDelete /
# DiffText in Neovim). Code inside the diff uses the bat EmberDay theme, so run
# ./bat/install.sh first.
#
# Install: ./delta/install.sh puts this in ~/.config/delta/, then add to
# ~/.gitconfig (the installer prints this, it never edits ~/.gitconfig):
#   [include]
#       path = ~/.config/delta/emberday.gitconfig
# and, if delta is not your pager yet:
#   [core]
#       pager = delta
#   [interactive]
#       diffFilter = delta --color-only

[delta]
    features = emberday

[delta "emberday"]
    light = true
    syntax-theme = EmberDay
    navigate = true
    line-numbers = true

    file-style = bold "#9F4219"
    file-decoration-style = "#BBB9B2" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#BBB9B2" box
    hunk-header-file-style = "#5C5F67"
    hunk-header-line-number-style = "#8A5E12"

    minus-style = "#9E3A3A" "#E9E6DF"
    minus-emph-style = bold "#DDD9D1" "#9E3A3A"
    minus-non-emph-style = "#9E3A3A" "#E9E6DF"
    plus-style = "#4C6B45" "#E9E6DF"
    plus-emph-style = bold "#DDD9D1" "#4C6B45"
    plus-non-emph-style = "#4C6B45" "#E9E6DF"
    zero-style = syntax
    whitespace-error-style = "#DDD9D1" "#8A5E12"

    line-numbers-left-style = "#BBB9B2"
    line-numbers-right-style = "#BBB9B2"
    line-numbers-minus-style = "#9E3A3A"
    line-numbers-plus-style = "#4C6B45"
    line-numbers-zero-style = "#8C9099"

    commit-style = bold "#8A5E12"
    commit-decoration-style = "#BBB9B2" box
    blame-palette = "#DDD9D1 #E9E6DF #CBC8C0"
    blame-code-style = syntax
    merge-conflict-begin-symbol = ▼
    merge-conflict-end-symbol = ▲
    merge-conflict-ours-diff-header-style = bold "#4C6B45"
    merge-conflict-theirs-diff-header-style = bold "#8A5E12"
